<?xml version='1.0' encoding='utf-8'?>
<roblox version="4"><Item class="Script" referent="77">
          <Properties>
            <string name="Name">R6Ragdoll</string>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <bool name="Disabled">false</bool>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <token name="RunContext">0</token>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{F0A174A0-BCB6-4955-B080-77742CBDE6DC}</string>
            <string name="Source">

local PhysicsService = game:GetService("PhysicsService")
local CollectionService = game:GetService("CollectionService")
local module = require(script.ModuleScript)
local ragParts = script.RagdollParts:GetChildren()
local r6Client = script.R6RagdollClient

local ATTACHMENT_PARENT = {
	LA0 = "Torso",
	LL0 = "Torso",
	N0 = "Torso",
	RA0 = "Torso",
	RL0 = "Torso",
	RL1 = "Right Leg",
	RA1 = "Right Arm",
	LL1 = "Left Leg",
	LA1 = "Left Arm",
	N1 = "Head",
}

local function attachmentParentName(attachmentName)
	return ATTACHMENT_PARENT[attachmentName]
end

local function constraintAttachmentName(constraintName, index)
	local base = constraintName:match("^(%a+)S$")
	if not base then return nil end
	return base .. tostring(index)
end


PhysicsService:RegisterCollisionGroup("Ragdoll")

local function SetupRagdoll(char)
	CollectionService:AddTag(char,"Rig")
	if game.Players:GetPlayerFromCharacter(char) then
		local humanoid = char.Humanoid
		-- Preserve the head dimensions authored in StarterCharacter.
		humanoid.BreakJointsOnDeath = false
		humanoid.RequiresNeck = false

		local clones = {}
		for _, v in ipairs(ragParts) do
			clones[v.Name] = v:Clone()
		end

		local folder1 = Instance.new("Folder")
		folder1.Name = "RagdollConstraints"
		for _, v in pairs(clones) do
			if v:IsA("Attachment") then
				local parentName = v:GetAttribute("Parent") or attachmentParentName(v.Name)
				local parentPart = parentName and char:FindFirstChild(parentName)
				if parentPart then v.Parent = parentPart end
			elseif v:IsA("BallSocketConstraint") then
				v.Attachment0 = clones[v:GetAttribute("0") or constraintAttachmentName(v.Name, 0)]
				v.Attachment1 = clones[v:GetAttribute("1") or constraintAttachmentName(v.Name, 1)]
				v.Parent = folder1
			end
		end
		folder1.Parent = char
		local folder2 = Instance.new("Folder")
		folder2.Name = "Motors"
		local value
		for _, v in ipairs(char.Torso:GetChildren()) do
			if v:IsA("Motor6D") then
				value = Instance.new("ObjectValue")
				value.Value = v
				value.Parent = folder2
			end
		end
		folder2.Parent = folder1 
		
		char.ChildAdded:Connect(function(bool)
			if bool.Name == "Ragdoll" then
				module:Ragdoll(char)
			end
		end)
		char.ChildRemoved:Connect(function(bool)
			if bool.Name == "Ragdoll" and not char:FindFirstChild("Ragdoll") then
				module:Unragdoll(char)
			end
		end)
		
		r6Client:Clone().Parent = char
	else
		require(script.ModuleScript):Setup(char)
	end
end

for i,part in pairs(workspace:GetDescendants()) do
	local char = part.Parent
	pcall(function()

		if char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") and not char:FindFirstChild("RagdollConstraints") then
			SetupRagdoll(char)
		end

	end) 
end

workspace.DescendantAdded:Connect(function(part)
	local char = part.Parent
	pcall(function()
		
		if char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") and not char:FindFirstChild("RagdollConstraints") then
			SetupRagdoll(char)
		end
		
	end) 
end)
