            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{4356A02E-729C-4D8B-9817-A20B2EC23C4F}</string>
            <string name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CharacterPresentation = require(game:GetService("ServerScriptService"):WaitForChild("Server"):WaitForChild("CharacterPresentation"))

Players.CharacterAutoLoads = false

local function getRemote(name)
	local existing = ReplicatedStorage:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	if existing then
		existing:Destroy()
	end
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = ReplicatedStorage
	return remote
end

local deathEvent = getRemote("PlayerDied")
local whiteFadeIn = getRemote("WhiteFadeIn")
local whiteFadeOut = getRemote("WhiteFadeOut")

local DEATH_SCREEN_TIME = 4.5
local FADE_TIME = 1.1

local observedCharacters = {}

local function onCharacterAdded(player, character)
	if observedCharacters[character] then return end
	observedCharacters[character] = true
	character.Destroying:Once(function()
		observedCharacters[character] = nil
	end)
	local humanoid = character:WaitForChild("Humanoid")

	humanoid.Died:Connect(function()
		if player.Parent ~= Players or player.Character ~= character then return end
		if player:GetAttribute("InRound") == true then
			player:SetAttribute("Eliminado", true)
		end
		local deaths = (player:GetAttribute("Deaths") or 0) + 1
		player:SetAttribute("Deaths", deaths)

		deathEvent:FireClient(player, DEATH_SCREEN_TIME, deaths)

		task.wait(DEATH_SCREEN_TIME)
		if player.Parent ~= Players or player.Character ~= character then return end

		whiteFadeIn:FireClient(player)
		task.wait(FADE_TIME)
		if player.Parent ~= Players then return end
		if player.Character ~= character then
			whiteFadeOut:FireClient(player)
			return
		end

		if player:GetAttribute("InRound") == true then
			CharacterPresentation.SpawnGameCharacter(player)
		else
			CharacterPresentation.SpawnLobbyAvatar(player)
		end

		task.wait(0.5)
		whiteFadeOut:FireClient(player)
	end)
end

local function watchPlayer(player)
	if player:GetAttribute("Deaths") == nil then
		player:SetAttribute("Deaths", 0)
	end
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	else
		player:LoadCharacter()
	end
end

Players.PlayerAdded:Connect(watchPlayer)
for _, player in Players:GetPlayers() do
	watchPlayer(player)
end</string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
