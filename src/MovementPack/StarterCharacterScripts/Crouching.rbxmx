            <string name="Source">local Players      = game:GetService("Players")
local CAS          = game:GetService("ContextActionService")
local RunService   = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UIS          = game:GetService("UserInputService")
local RushModules = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local RushRules = require(RushModules:WaitForChild("ShadowRushRules"))
local RushConfig = require(RushModules:WaitForChild("GameConfig")).Monster.ShadowRush

local plr       = Players.LocalPlayer
local Character = plr.Character or plr.CharacterAdded:Wait()
local Humanoid  = Character:WaitForChild("Humanoid")
local RootPart  = Character:WaitForChild("HumanoidRootPart")
local Camera    = workspace.CurrentCamera

-- =============================================
-- VIGNETTE
-- =============================================
local PlayerGui   = plr:WaitForChild("PlayerGui")
local VignetteGui = PlayerGui:WaitForChild("Vignette", 5)

if VignetteGui then
	VignetteGui.IgnoreGuiInset = true
else
	warn("[Crouch] Vignette ScreenGui not found; crouch will continue without vignette")
end

local VignetteElement = nil
if VignetteGui then
	VignetteElement = VignetteGui:FindFirstChildWhichIsA("ImageLabel")
		or VignetteGui:FindFirstChildWhichIsA("Frame")
end

if not VignetteElement then
	warn("[Crouch] No ImageLabel or Frame found inside 'Vignette' ScreenGui")
end

if VignetteElement then
	VignetteElement.AnchorPoint = Vector2.new(0, 0)
	VignetteElement.Position    = UDim2.new(0, 0, 0, 0)
	VignetteElement.Size        = UDim2.new(1, 0, 1, 0)

	if VignetteElement:IsA("ImageLabel") then
		VignetteElement.ImageTransparency = 1
	else
		VignetteElement.BackgroundTransparency = 1
	end
end

local vignetteTween = nil

-- =============================================
-- CONFIG
-- =============================================
-- [Meujogo] TRES ESTADOS DE SOLO, no estilo Friday the 13th:
--   ANDAR  (NormalSpeed) -- o movimento PADRAO: quem nao segura nada esta
--                           andando, exatamente como era antes desta mudanca
--                           (o unico estado de solo do jogo, ate aqui).
--   TROTAR (JogSpeed)    -- mais rapido que andar, mais lento que correr.
--                           Segura ControlKey pra ligar; solta pra voltar a
--                           andar. Nao gasta folego.
--   CORRER (SprintSpeed) -- maximo, gasta folego, denuncia a posicao.
-- A ordem de barulho que o servidor enxerga sai dessas proporcoes sobre
-- NormalSpeed = 12 (ver GameConfig.Characters.MovementBands):
--   rastejar 0,25 &lt; agachar 0,50 &lt; ANDAR 1,00 &lt; TROTAR 1,25 &lt; CORRER 1,92.
-- Mexer aqui muda a classificacao de ruido: revise as bandas junto.
local CONFIG = {
	NormalSpeed  = 12, -- ANDAR (padrao)
	JogSpeed     = 15, -- TROTAR (segurar ControlKey)
	SprintSpeed  = 23, -- CORRER
	CrouchSpeed  = 6,
	CrawlSpeed   = 3,
	WaterSpeed   = 7, -- [Meujogo] teto de velocidade nadando / na agua

	WalkAnimSpeed        = 0.8,
	RunAnimSpeed         = 1.4,
	CrouchIdleAnimSpeed  = 1.0,
	CrouchWalkAnimSpeed  = 1.0,
	CrouchAnimFadeTime   = 0.3,
	CrawlIdleAnimSpeed   = 1.0,
	CrawlWalkAnimSpeed   = 1.0,

	DefaultFOV   = 68,
	SprintFOV    = 75,
	JogFOV       = 71,
	JogFOVTime   = 0.3,
	CrouchFOV    = 66,
	CrawlFOV     = 64,

	SprintFOVTime  = 0.35,
	CrouchFOVTime  = 0.4,
	CrawlFOVTime   = 0.4,
	DefaultFOVTime = 0.5,

	CrouchCamOffset = -1.5,
	CrawlCamOffset  = -2.8,

	CrouchCooldown  = 0.2,
	CrawlCooldown   = 0.2,
	MaxFreefallTime = 0.5,

	VignetteVisible     = 0.3,
	VignetteCrawl       = 0.55,
	VignetteFadeInTime  = 0.4,
	VignetteFadeOutTime = 0.4,

	CrouchKey  = Enum.KeyCode.C,
	CrawlKey   = Enum.KeyCode.Z,
	-- [Meujogo] TROTAR e SEGURAR (igual o sprint), nao alternavel.
	JogKeys = {
		Enum.KeyCode.LeftControl,
		Enum.KeyCode.RightControl,
	},
	SprintKeys = {
		Enum.KeyCode.LeftShift,
		Enum.KeyCode.RightShift,
	},

	ActionPriority = 2500,
}

local ANIMATION_PROFILE = "Previous"
local ANIMATION_PROFILES = {
	ImportedArczis = {
		Crouching = "rbxassetid://99310824682831",
		CrouchWalk = "rbxassetid://75389389155590",
		CrouchToCrawl = "rbxassetid://112601350268211",
		CrawlIdle = "rbxassetid://73311533107544",
		CrawlWalk = "rbxassetid://95112663243010",
		CrawlToCrouch = "rbxassetid://83587230625164",
	},
	Previous = {
		Crouching = "rbxassetid://108853143115126",
		CrouchWalk = "rbxassetid://125168404409395",
		CrouchToCrawl = "",
		CrawlIdle = "",
		CrawlWalk = "",
		CrawlToCrouch = "",
	},
}
local ANIMATION_IDS = ANIMATION_PROFILES[ANIMATION_PROFILE]
assert(ANIMATION_IDS, "Perfil de animação inválido: " .. tostring(ANIMATION_PROFILE))

local ANIMATION_ALIASES = {
	Crouching = { "Crouching", "CrouchIdle", "Crouch Idle", "Crouch", "Agachar", "Agachado", "AgacharIdle" },
	CrouchWalk = { "CrouchWalk", "Crouch Walk", "CrouchingWalk", "AgacharWalk", "AgachadoWalk", "AndarAgachado" },
	CrouchToCrawl = { "CrouchToCrawl", "Crouch To Crawl", "AgacharParaRastejar", "ToCrawl" },
	CrawlIdle = { "CrawlIdle", "Crawl Idle", "Crawl", "RastejarIdle", "Rastejando", "Deitado" },
	CrawlWalk = { "CrawlWalk", "Crawl Walk", "RastejarWalk", "RastejandoWalk", "AndarRastejando" },
	CrawlToCrouch = { "CrawlToCrouch", "Crawl To Crouch", "RastejarParaAgachar", "ToCrouch" },
}

-- =============================================
-- STATE
-- =============================================
local isCrouching       = false
local isCrawling        = false
local isTransitioning   = false
local isSprinting       = false
local sprintKeyHeld     = false
local isJogging         = false -- [Meujogo] trotar (segurando ControlKey)
local jogKeyHeld        = false
local crouchDebounce    = true
local crawlDebounce     = true
local isOnGround        = true
local notMoving         = true
local freefallTimer     = 0
local fovTween          = nil
local currentCrouchAnim = nil
local currentCrawlAnim  = nil

-- =============================================
-- ANIMATIONS
-- =============================================
local Animator = Humanoid:FindFirstChildOfClass("Animator")
	or Instance.new("Animator", Humanoid)

local function normalizeAnimName(name)
	return string.lower((name:gsub("[^%w]", "")))
end

local function hasAnimationId(animObj)
	return animObj and animObj:IsA("Animation") and animObj.AnimationId ~= ""
end

local function findAnimationAsset(animName, ignoredAnim)
	local aliases = ANIMATION_ALIASES[animName] or { animName }
	local wanted = {}
	for _, alias in ipairs(aliases) do
		wanted[normalizeAnimName(alias)] = true
	end

	local roots = { script, Character }
	local replicatedStorage = game:GetService("ReplicatedStorage")
	table.insert(roots, replicatedStorage)

	local workspaceAnimations = workspace:FindFirstChild("Animations")
		or workspace:FindFirstChild("AnimationPack")
		or workspace:FindFirstChild("MovementAnimations")
	if workspaceAnimations then
		table.insert(roots, workspaceAnimations)
	end

	for _, root in ipairs(roots) do
		for _, child in ipairs(root:GetDescendants()) do
			if child ~= ignoredAnim and child:IsA("Animation") and wanted[normalizeAnimName(child.Name)] and child.AnimationId ~= "" then
				return child
			end
		end
	end

	return nil
end

local function ensureAnimation(animName)
	local animObj = script:FindFirstChild(animName)
	local configuredId = ANIMATION_IDS[animName]
	local discovered = nil

	-- IDs definidos neste script sao autoritativos. A busca por aliases serve
	-- apenas para animacoes opcionais sem ID configurado.
	if not configuredId or configuredId == "" then
		discovered = findAnimationAsset(animName, animObj)
	end

	if not animObj or not animObj:IsA("Animation") then
		if discovered then
			animObj = discovered:Clone()
		else
			animObj = Instance.new("Animation")
		end
		animObj.Name = animName
		animObj.Parent = script
	end
	if animObj:IsA("Animation") then
		local id = if configuredId and configuredId ~= "" then configuredId
			elseif hasAnimationId(discovered) then discovered.AnimationId
			elseif hasAnimationId(animObj) then animObj.AnimationId
			else ""
		if id and id ~= "" then
			animObj.AnimationId = id
			return animObj
		end
	end
	return nil
end

local function safeLoadAnim(animName)
	local configuredId = ANIMATION_IDS[animName]
	local animObj
	if configuredId and configuredId ~= "" then
		-- Mesmo caminho simples usado pelo teste da tecla N, que carregou
		-- corretamente no jogo: cria o objeto com o ID final e carrega direto.
		animObj = Instance.new("Animation")
		animObj.Name = animName
		animObj.AnimationId = configuredId
	else
		animObj = ensureAnimation(animName)
	end
	if not animObj then
		warn("[Crouch] Missing Animation child: " .. animName)
		return nil
	end
	local ok, track = pcall(function()
		return Animator:LoadAnimation(animObj)
	end)
	if ok then
		task.delay(2, function()
			if track.IsPlaying and track.Length == 0 then
				warn("[Crouch] Animation did not load: " .. animName .. " (" .. animObj.AnimationId .. "). Check ownership and rig type.")
			end
		end)
		return track
	end
	warn("[Crouch] Could not load " .. animName .. " (" .. animObj.AnimationId .. "): " .. tostring(track))
	return nil
end

local CrouchIdle    = safeLoadAnim("Crouching")
local CrouchWalk    = safeLoadAnim("CrouchWalk")
local CrouchToCrawl = safeLoadAnim("CrouchToCrawl")
local CrawlIdle     = safeLoadAnim("CrawlIdle")
local CrawlWalk     = safeLoadAnim("CrawlWalk")
local CrawlToCrouch = safeLoadAnim("CrawlToCrouch")

local function configureMovementTrack(track)
	if track then
		track.Priority = Enum.AnimationPriority.Action
		track.Looped = true
	end
end

configureMovementTrack(CrouchIdle)
configureMovementTrack(CrouchWalk)
configureMovementTrack(CrouchToCrawl)
configureMovementTrack(CrawlIdle)
configureMovementTrack(CrawlWalk)
configureMovementTrack(CrawlToCrouch)

if CrawlIdle then CrawlIdle.Looped = true end
if CrawlWalk then CrawlWalk.Looped = true end
if CrouchIdle then CrouchIdle.Looped = true end -- [Meujogo] forca loop
if CrouchWalk then CrouchWalk.Looped = true end -- [Meujogo] forca loop
if CrouchToCrawl then CrouchToCrawl.Looped = false end
if CrawlToCrouch then CrawlToCrouch.Looped = false end

-- =============================================
-- IK FOOT DISABLE HELPERS
-- =============================================
local function getIKParts()
	local vm = Character:FindFirstChild("ViewModel")
	if not vm then return nil end

	local vmLeft  = vm:FindFirstChild("Left Leg")
	local vmRight = vm:FindFirstChild("Right Leg")
	local realLeft  = Character:FindFirstChild("Left Leg")
	local realRight = Character:FindFirstChild("Right Leg")

	return vmLeft, vmRight, realLeft, realRight
end

local ikCurrentlyDisabled = false

local function setIKFeetEnabled(enabled)
	local vmLeft, vmRight, realLeft, realRight = getIKParts()

	if enabled then
		if vmLeft then vmLeft.Transparency = 0 end
		if vmRight then vmRight.Transparency = 0 end
		if realLeft then realLeft.Transparency = 1 end
		if realRight then realRight.Transparency = 1 end
		ikCurrentlyDisabled = false
	else
		if vmLeft then vmLeft.Transparency = 1 end
		if vmRight then vmRight.Transparency = 1 end
		if realLeft then realLeft.Transparency = 0 end
		if realRight then realRight.Transparency = 0 end
		ikCurrentlyDisabled = true
	end
end

-- =============================================
-- CRAWL LOCK (turning script joint conflict fix)
-- =============================================
--[[
	Sets an attribute the turning script checks to
	completely skip its Hip/RootJoint/Neck C0 writes
	while we're crawling or transitioning in/out of
	crawl. Without this, the turning script fights
	the CrawlIdle/CrawlWalk animations every frame
	and mangles the leg positions.

	Requires ONE line added to the turning script's
	Calculate() function (see chat) — everything else
	in that script remains untouched.
]]
local function setCrawlLock(locked)
	RootPart:SetAttribute("CrawlLock", locked)
end

-- =============================================
-- HELPERS
-- =============================================
-- [Meujogo] Movimento e mira compartilham o mesmo tween de FOV.
local movementFOV = CONFIG.DefaultFOV
Character:SetAttribute("MovementCameraFOV", movementFOV)
local function tweenFOV(target, duration)
	movementFOV = target
	Character:SetAttribute("MovementCameraFOV", target)
	if plr:GetAttribute("AdaptiveShoulderCameraActive") == true then
		if fovTween then fovTween:Cancel(); fovTween = nil end
		return
	end
	Camera = workspace.CurrentCamera
	if not Camera then return end
	if Camera.CameraType ~= Enum.CameraType.Custom then return end
	if Character:GetAttribute("FirearmAiming") == true then
		local aimFOV = Character:GetAttribute("FirearmAimFOV")
		target = math.min(target, if type(aimFOV) == "number" then aimFOV else 62)
	end
	-- One FOV owner: compose the ability with the movement/aim target here.
	if Character:GetAttribute("ShadowRushBusy") == true then
		target = CONFIG.DefaultFOV + (Character:GetAttribute("ShadowRushFOV") or 0)
	end
	if fovTween then fovTween:Cancel() end
	fovTween = TweenService:Create(
		Camera,
		TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ FieldOfView = target }
	)
	fovTween:Play()
end

Character:GetAttributeChangedSignal("FirearmAiming"):Connect(function()
	tweenFOV(movementFOV, 0.18)
end)
Character:GetAttributeChangedSignal("FirearmAimFOV"):Connect(function()
	if Character:GetAttribute("FirearmAiming") == true then tweenFOV(movementFOV, 0.18) end
end)
Character:GetAttributeChangedSignal("ShadowRushFOV"):Connect(function()
	tweenFOV(movementFOV, 0.12)
end)
Character:GetAttributeChangedSignal("ShadowRushBusy"):Connect(function()
	tweenFOV(movementFOV, 0.2)
end)
plr:GetAttributeChangedSignal("AdaptiveShoulderCameraActive"):Connect(function()
	tweenFOV(movementFOV, 0.2)
end)
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	tweenFOV(movementFOV, 0.2)
end)

local function tweenCamOffset(y, duration)
	TweenService:Create(
		Humanoid,
		TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ CameraOffset = Vector3.new(0, y, 0) }
	):Play()
end

-- O crouch/crawl e a mira OTS compartilham a mesma vinheta do jogo.
-- movementVignetteTransparency guarda o estado de movimento; a mira apenas
-- compõe o resultado, evitando um segundo ScreenGui sobre a tela.
local movementVignetteTransparency = 1
local function renderVignette(targetTransparency, duration)
	if not VignetteElement then return end
	if Character:GetAttribute("FirearmAiming") == true then
		targetTransparency = math.min(targetTransparency, 0.6)
	end
	if vignetteTween then
		vignetteTween:Cancel()
		vignetteTween = nil
	end

	local prop
	if VignetteElement:IsA("ImageLabel") then
		prop = { ImageTransparency = targetTransparency }
	else
		prop = { BackgroundTransparency = targetTransparency }
	end

	vignetteTween = TweenService:Create(
		VignetteElement,
		TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		prop
	)
	vignetteTween:Play()
end

local function setVignette(targetTransparency, duration)
	movementVignetteTransparency = targetTransparency
	renderVignette(targetTransparency, duration)
end

Character:GetAttributeChangedSignal("FirearmAiming"):Connect(function()
	renderVignette(movementVignetteTransparency, 0.18)
end)

local SPEED_FLOOR = 0.001

local function rushSpeed()
	local base = Character:GetAttribute("ShadowRushBaseSpeed") or CONFIG.NormalSpeed
	return RushRules.Speed(Character:GetAttribute("ShadowRushState") or "Idle",
		math.max(0, workspace:GetServerTimeNow() - (Character:GetAttribute("ShadowRushPhaseAt") or workspace:GetServerTimeNow())),
		base, Character:GetAttribute("ShadowRushExitSpeed") or base, RushConfig)
end

local function safeSetSpeed(speed)
	if Character:GetAttribute("PowerStunned") == true then Humanoid.WalkSpeed = 0; return end
	if Character:GetAttribute("ShadowRushBusy") == true then Humanoid.WalkSpeed = rushSpeed(); return end
	Humanoid.WalkSpeed = math.max(speed, SPEED_FLOOR)
end

local function applySpeed()
	if isTransitioning then
		safeSetSpeed(SPEED_FLOOR)
	elseif isCrawling then
		safeSetSpeed(CONFIG.CrawlSpeed)
	elseif isCrouching then
		safeSetSpeed(CONFIG.CrouchSpeed)
	elseif isSprinting then
		safeSetSpeed(CONFIG.SprintSpeed)
	elseif isJogging then
		safeSetSpeed(CONFIG.JogSpeed)
	else
		safeSetSpeed(CONFIG.NormalSpeed) -- ANDAR: o padrao de quem nao aperta nada
	end
end

-- [Meujogo] TROTAR: segura ControlKey pra ligar, solta pra voltar a andar --
-- igual o sprint, so que mais lento e sem gastar folego. O Attribute e so
-- para o proprio cliente (animacao/HUD): quem decide o barulho no servidor
-- e a VELOCIDADE medida, nunca este booleano -- entao forjar "estou andando"
-- nao silencia ninguem.
local function canJogNow()
	if Character:GetAttribute("FearTripping") == true then return false end
	if Character:GetAttribute("FirearmAiming") == true then return false end
	return true
end

local function startJog()
	if isCrouching or isCrawling or isTransitioning or isSprinting then return end
	if isJogging then return end
	if not canJogNow() then return end

	isJogging = true
	RootPart:SetAttribute("IsJogging", true)
	applySpeed()
	tweenFOV(CONFIG.JogFOV, CONFIG.JogFOVTime)
end

local function stopJog()
	if not isJogging then return end
	isJogging = false
	RootPart:SetAttribute("IsJogging", false)
	applySpeed()
	if not isCrouching and not isCrawling and not isSprinting then
		tweenFOV(CONFIG.DefaultFOV, CONFIG.DefaultFOVTime)
	end
end

local function isMovingBackwards()
	local vel = RootPart.Velocity
	if Vector3.new(vel.X, 0, vel.Z).Magnitude &lt; 0.5 then return false end
	return vel.Unit:Dot(RootPart.CFrame.LookVector) &lt; -0.2
end

local function isMovingForward()
	local vel = RootPart.Velocity
	if Vector3.new(vel.X, 0, vel.Z).Magnitude &lt; 0.5 then return false end
	return vel.Unit:Dot(RootPart.CFrame.LookVector) &gt; 0.2
end

local function isObstructed()
	local head = Character:FindFirstChild("Head")
	if not head then return false end
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {Character}
	return workspace:Raycast(head.Position, Vector3.new(0, 2.5, 0), params) ~= nil
end

local function isObstructedForStand()
	local head = Character:FindFirstChild("Head")
	if not head then return false end
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {Character}
	return workspace:Raycast(head.Position, Vector3.new(0, 3.5, 0), params) ~= nil
end

local function canSprintNow()
	if Character:GetAttribute("FearTripping") == true then return false end
	if Character:GetAttribute("FirearmAiming") == true then return false end
	local can = RootPart:GetAttribute("CanSprint")
	if can == nil then return true end
	return can == true
end

local function shouldForceStopSprint()
	return RootPart:GetAttribute("ForceStopSprint") == true or Character:GetAttribute("FirearmAiming") == true
		or Character:GetAttribute("FearTripping") == true
end

-- =============================================
-- CROUCH ANIMATIONS
-- =============================================
local function stopCrouchAnims()
	if CrouchIdle and CrouchIdle.IsPlaying then CrouchIdle:Stop(CONFIG.CrouchAnimFadeTime) end
	if CrouchWalk and CrouchWalk.IsPlaying then CrouchWalk:Stop(CONFIG.CrouchAnimFadeTime) end
	currentCrouchAnim = nil
end

local function updateCrouchAnims()
	if not isCrouching or isCrawling or isTransitioning then return end

	if notMoving then
		if currentCrouchAnim ~= "idle" or not CrouchIdle or not CrouchIdle.IsPlaying then
			if not CrouchIdle then
				CrouchIdle = safeLoadAnim("Crouching")
				configureMovementTrack(CrouchIdle)
			end
			if not CrouchIdle then return end
			CrouchIdle:Play(CONFIG.CrouchAnimFadeTime)
			CrouchIdle:AdjustSpeed(CONFIG.CrouchIdleAnimSpeed)
			if CrouchWalk and CrouchWalk.IsPlaying then CrouchWalk:Stop(CONFIG.CrouchAnimFadeTime) end
			currentCrouchAnim = "idle"
		end
	else
		if currentCrouchAnim ~= "walk" or not CrouchWalk or not CrouchWalk.IsPlaying then
			if not CrouchWalk then
				CrouchWalk = safeLoadAnim("CrouchWalk")
				configureMovementTrack(CrouchWalk)
			end
			if not CrouchWalk then return end
			CrouchWalk:Play(CONFIG.CrouchAnimFadeTime)
			CrouchWalk:AdjustSpeed(CONFIG.CrouchWalkAnimSpeed)
			if CrouchIdle and CrouchIdle.IsPlaying then CrouchIdle:Stop(CONFIG.CrouchAnimFadeTime) end
			currentCrouchAnim = "walk"
		end
	end
end

-- =============================================
-- CRAWL ANIMATIONS
-- =============================================
local function stopCrawlAnims()
	if CrawlIdle and CrawlIdle.IsPlaying then CrawlIdle:Stop(0.2) end
	if CrawlWalk and CrawlWalk.IsPlaying then CrawlWalk:Stop(0.2) end
	currentCrawlAnim = nil
end

local function updateCrawlAnims()
	if not isCrawling or isTransitioning then return end

	if notMoving then
		if currentCrawlAnim ~= "idle" then
			if CrawlWalk and CrawlWalk.IsPlaying then CrawlWalk:Stop(0.2) end
			if CrawlIdle and not CrawlIdle.IsPlaying then
				CrawlIdle:Play(0.2)
				CrawlIdle:AdjustSpeed(CONFIG.CrawlIdleAnimSpeed)
			end
			currentCrawlAnim = "idle"
		end
	else
		if currentCrawlAnim ~= "walk" then
			if CrawlIdle and CrawlIdle.IsPlaying then CrawlIdle:Stop(0.2) end
			if CrawlWalk and not CrawlWalk.IsPlaying then
				CrawlWalk:Play(0.2)
				CrawlWalk:AdjustSpeed(CONFIG.CrawlWalkAnimSpeed)
			end
			currentCrawlAnim = "walk"
		end
	end
end

-- =============================================
-- SPRINT
-- =============================================
local function startSprint()
	if isCrouching or isCrawling or isTransitioning then return end
	if isSprinting then return end
	if not canSprintNow() then return end

	isSprinting = true
	RootPart:SetAttribute("IsSprinting", true)
	-- [Meujogo] correr cancela o trote: Shift e intencao explicita de barulho.
	-- Chamado DEPOIS de isSprinting = true para nao disputar o FOV da corrida.
	stopJog()
	applySpeed()
	tweenFOV(CONFIG.SprintFOV, CONFIG.SprintFOVTime)
end

local function stopSprint()
	if not isSprinting then return end
	isSprinting = false
	RootPart:SetAttribute("IsSprinting", false)
	applySpeed()
	if not isCrouching and not isCrawling then
		tweenFOV(CONFIG.DefaultFOV, CONFIG.DefaultFOVTime)
	end
end

-- =============================================
-- CRAWL — enter (must already be crouching)
-- =============================================
local function doCrawl()
	if not crawlDebounce then return end
	if isCrawling or isTransitioning then return end
	if not isCrouching then return end
	if not isOnGround then return end

	crawlDebounce   = false
	isCrawling      = true
	isTransitioning = true

	-- Lock BOTH the IK feet and the turning script's joint writes
	setIKFeetEnabled(false)
	setCrawlLock(true)

	RootPart:SetAttribute("IsCrawling", true)

	stopCrouchAnims()

	tweenFOV(CONFIG.CrawlFOV, CONFIG.CrawlFOVTime)
	tweenCamOffset(CONFIG.CrawlCamOffset, 0.35)
	setVignette(1 - CONFIG.VignetteCrawl, CONFIG.VignetteFadeInTime)

	applySpeed()

	if CrouchToCrawl then
		CrouchToCrawl:Play(0.1)
		CrouchToCrawl:AdjustSpeed(1)

		local conn
		conn = CrouchToCrawl.Stopped:Connect(function()
			conn:Disconnect()
			isTransitioning = false
			if isCrawling then
				applySpeed()
				updateCrawlAnims()
			end
		end)
	else
		isTransitioning = false
		applySpeed()
		updateCrawlAnims()
	end

	task.delay(CONFIG.CrawlCooldown, function()
		crawlDebounce = true
	end)
end

-- =============================================
-- CRAWL — exit (return to crouch)
-- =============================================
local function doStopCrawl()
	if not isCrawling or isTransitioning then return end

	isCrawling      = false
	isTransitioning = true

	-- Keep CrawlLock + IK disabled through the ENTIRE
	-- crawl-&gt;crouch transition animation

	RootPart:SetAttribute("IsCrawling", false)

	stopCrawlAnims()

	tweenFOV(CONFIG.CrouchFOV, CONFIG.CrouchFOVTime)
	tweenCamOffset(CONFIG.CrouchCamOffset, 0.35)
	setVignette(1 - CONFIG.VignetteVisible, CONFIG.VignetteFadeOutTime)

	applySpeed()

	if CrawlToCrouch then
		CrawlToCrouch:Play(0.1)
		CrawlToCrouch:AdjustSpeed(1)

		local conn
		conn = CrawlToCrouch.Stopped:Connect(function()
			conn:Disconnect()
			isTransitioning = false
			if isCrouching and not isCrawling then
				applySpeed()
				updateCrouchAnims()
				-- Fully back in crouch: safe to release both locks
				setIKFeetEnabled(true)
				setCrawlLock(false)
			end
		end)
	else
		isTransitioning = false
		applySpeed()
		updateCrouchAnims()
		setIKFeetEnabled(true)
		setCrawlLock(false)
	end
end

-- =============================================
-- CROUCH / STANDUP
-- =============================================
local function doCrouch()
	if not crouchDebounce then return end
	if isCrouching or isTransitioning then return end
	if not isOnGround then return end

	crouchDebounce = false
	isSprinting    = false
	isJogging      = false
	RootPart:SetAttribute("IsSprinting", false)
	RootPart:SetAttribute("IsJogging", false)
	isCrouching    = true

	RootPart:SetAttribute("IsCrouching", true)

	applySpeed()
	updateCrouchAnims()

	setVignette(1 - CONFIG.VignetteVisible, CONFIG.VignetteFadeInTime)
	tweenFOV(CONFIG.CrouchFOV, CONFIG.CrouchFOVTime)

	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	tweenCamOffset(CONFIG.CrouchCamOffset, 0.25)

	task.delay(CONFIG.CrouchCooldown, function()
		crouchDebounce = true
	end)
end

local function doStandUp()
	if not isCrouching or isTransitioning then return end
	if isObstructed() then return end

	if isCrawling then
		if isObstructedForStand() then return end
		doStopCrawl()

		local transLen = (CrawlToCrouch and CrawlToCrouch.Length) or 0.3
		task.delay(transLen + 0.05, function()
			if not isCrawling and isCrouching and not isTransitioning then
				doStandUp()
			end
		end)
		return
	end

	isCrouching       = false
	currentCrouchAnim = nil

	RootPart:SetAttribute("IsCrouching", false)

	stopCrouchAnims()
	applySpeed()

	setVignette(1, CONFIG.VignetteFadeOutTime)
	tweenFOV(CONFIG.DefaultFOV, CONFIG.DefaultFOVTime)

	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
	tweenCamOffset(0, 0.25)
end

-- =============================================
-- INPUT
-- =============================================
local function inputIsBlocked()
	return UIS:GetFocusedTextBox() ~= nil
		or plr:GetAttribute("CursorLivre") == true
		or Character:GetAttribute("ShadowRushBusy") == true
end

local function handleCrouchAction(_, state)
	if state ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Sink
	end
	if inputIsBlocked() then
		return Enum.ContextActionResult.Pass
	end

	if isCrawling then
		doStopCrawl()
	elseif isCrouching then
		doStandUp()
	else
		doCrouch()
	end

	return Enum.ContextActionResult.Sink
end

local function handleCrawlAction(_, state)
	if state ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Sink
	end
	if inputIsBlocked() then
		return Enum.ContextActionResult.Pass
	end

	if isCrawling then
		doStopCrawl()
	elseif isCrouching then
		doCrawl()
	end

	return Enum.ContextActionResult.Sink
end

CAS:BindActionAtPriority("MeujogoCrouch", handleCrouchAction, true, CONFIG.ActionPriority, CONFIG.CrouchKey, Enum.KeyCode.ButtonB)
CAS:SetTitle("MeujogoCrouch", "Agachar")
CAS:SetPosition("MeujogoCrouch", UDim2.fromScale(0.82, 0.56))
CAS:BindActionAtPriority("MeujogoCrawl", handleCrawlAction, true, CONFIG.ActionPriority, CONFIG.CrawlKey, Enum.KeyCode.ButtonL3)
CAS:SetTitle("MeujogoCrawl", "Rastejar")
CAS:SetPosition("MeujogoCrawl", UDim2.fromScale(0.82, 0.44))

UIS.InputBegan:Connect(function(input, typing)
	if typing or UIS:GetFocusedTextBox() or Character:GetAttribute("ShadowRushBusy") == true then return end

	for _, key in ipairs(CONFIG.SprintKeys) do
		if input.KeyCode == key then
			sprintKeyHeld = true
			if not isCrouching and not isCrawling
				and not isTransitioning and isMovingForward() then
				startSprint()
			end
			return
		end
	end

	for _, key in ipairs(CONFIG.JogKeys) do
		if input.KeyCode == key then
			jogKeyHeld = true
			if not isCrouching and not isCrawling and not isTransitioning and not isSprinting then
				startJog()
			end
			return
		end
	end
end)

UIS.InputEnded:Connect(function(input, _typing)
	for _, key in ipairs(CONFIG.SprintKeys) do
		if input.KeyCode == key then
			sprintKeyHeld = false
			stopSprint()
			return
		end
	end

	for _, key in ipairs(CONFIG.JogKeys) do
		if input.KeyCode == key then
			jogKeyHeld = false
			stopJog()
			return
		end
	end
end)

-- =============================================
-- HEARTBEAT
-- =============================================
RunService.Heartbeat:Connect(function(dt)
	-- Character swap pode acontecer enquanto Shift continua fisicamente
	-- pressionado; nesse caso não existe um novo InputBegan para o script
	-- recém-criado. Reconciliar com o teclado torna o sprint determinístico.
	if UIS.KeyboardEnabled then
		sprintKeyHeld = UIS:IsKeyDown(Enum.KeyCode.LeftShift)
			or UIS:IsKeyDown(Enum.KeyCode.RightShift)
	end
	if Character:GetAttribute("PowerStunned") == true then
		stopSprint()
		stopJog()
		Humanoid.WalkSpeed = 0
		Humanoid.Jump = false
		return
	end
	if Character:GetAttribute("LandingLocked") == true then
		stopSprint()
		stopJog()
		Humanoid.WalkSpeed = 0
		Humanoid.Jump = false
		return
	end
	if Character:GetAttribute("ShadowRushBusy") == true then
		stopSprint()
		stopJog()
		Humanoid.WalkSpeed = rushSpeed()
		Humanoid.Jump = false
		return
	end
	notMoving  = Humanoid.MoveDirection.Magnitude &lt; 0.1
	isOnGround = Humanoid.FloorMaterial ~= Enum.Material.Air

	local targetSpeed
	if isTransitioning then
		targetSpeed = SPEED_FLOOR
	elseif isCrawling then
		targetSpeed = CONFIG.CrawlSpeed
	elseif isCrouching then
		targetSpeed = CONFIG.CrouchSpeed
	elseif isSprinting then
		targetSpeed = CONFIG.SprintSpeed
	elseif isJogging then
		targetSpeed = CONFIG.JogSpeed
	else
		targetSpeed = CONFIG.NormalSpeed -- ANDAR
	end
	Humanoid.WalkSpeed = math.max(targetSpeed, SPEED_FLOOR)

	-- [Meujogo] resistencia da agua: nadando ou pisando em Water, corta
	-- a velocidade. Roda logo depois do pacote setar o WalkSpeed (mesmo
	-- frame), entao nao ha briga.
	if Humanoid.FloorMaterial == Enum.Material.Water
		or Humanoid:GetState() == Enum.HumanoidStateType.Swimming then
		Humanoid.WalkSpeed = math.min(Humanoid.WalkSpeed, CONFIG.WaterSpeed)
	end

	-- [Meujogo] Monstro anda mais rapido (MonsterCombat.lua publica esse
	-- Attribute no character: SpeedMultiplier normal, WeakenedSpeedMultiplier
	-- enquanto fraco pela luz; nil pra quem nao e Monstro).
	local monMul = Character:GetAttribute("MonsterSpeedMul")
	if type(monMul) == "number" and monMul &gt; 0 and Humanoid.WalkSpeed &gt; SPEED_FLOOR then
		Humanoid.WalkSpeed *= monMul
	end

	-- [Meujogo] VELOCIDADE do personagem escolhido (CharacterStatsApplier
	-- publica esse Attribute; Rafael ~1.4x, Diego ~0.9x). Multiplica junto com
	-- o do Monstro, entao os dois compoem.
	local statMul = Character:GetAttribute("SpeedMul")
	if type(statMul) == "number" and statMul &gt; 0 and Humanoid.WalkSpeed &gt; SPEED_FLOOR then
		Humanoid.WalkSpeed *= statMul
	end

	local powerMul = Character:GetAttribute("PowerSpeedMultiplier")
	if type(powerMul) == "number" then Humanoid.WalkSpeed *= powerMul end

	-- [Meujogo] FearSystem decide o tropeço no servidor. Limite próprio, sem
	-- disputar CanSprint/ForceStopSprint com a stamina nem empilhar SpeedMul.
	local fearSpeedCap = Character:GetAttribute("FearTripSpeedCap")
	if type(fearSpeedCap) == "number" then
		Humanoid.WalkSpeed = math.min(Humanoid.WalkSpeed, fearSpeedCap)
	end

	-- Safety nets: keep locks correctly synced every frame
	if (isCrawling or isTransitioning) then
		if not ikCurrentlyDisabled then
			setIKFeetEnabled(false)
		end
		if not RootPart:GetAttribute("CrawlLock") then
			setCrawlLock(true)
		end
	end

	if isCrouching or isCrawling then
		if not isOnGround then
			freefallTimer += dt
			if freefallTimer &gt;= CONFIG.MaxFreefallTime then
				if isCrawling then
					isCrawling      = false
					isTransitioning = false
					RootPart:SetAttribute("IsCrawling", false)
					stopCrawlAnims()
					if CrouchToCrawl and CrouchToCrawl.IsPlaying then
						CrouchToCrawl:Stop(0)
					end
					if CrawlToCrouch and CrawlToCrouch.IsPlaying then
						CrawlToCrouch:Stop(0)
					end
				end
				if isCrouching then
					isCrouching       = false
					isTransitioning   = false
					currentCrouchAnim = nil
					RootPart:SetAttribute("IsCrouching", false)
					stopCrouchAnims()
					Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
					tweenCamOffset(0, 0.2)
					setVignette(1, CONFIG.VignetteFadeOutTime)
					tweenFOV(CONFIG.DefaultFOV, CONFIG.DefaultFOVTime)
				end
				-- Full emergency exit: release both locks
				setIKFeetEnabled(true)
				setCrawlLock(false)
			end
		else
			freefallTimer = 0
		end
	else
		freefallTimer = 0
	end

	if isCrawling then
		updateCrawlAnims()
	elseif isCrouching then
		updateCrouchAnims()
	end

	if not isCrouching and not isCrawling and not isTransitioning then
		if isSprinting and shouldForceStopSprint() then
			stopSprint()
		end

		if isSprinting then
			if isMovingBackwards() or notMoving then
				stopSprint()
			end
		else
			if sprintKeyHeld and isMovingForward() and canSprintNow() then
				startSprint()
			end
		end

		if not isSprinting then
			if isJogging and (notMoving or not canJogNow()) then
				stopJog()
			elseif not isJogging and jogKeyHeld and canJogNow() then
				startJog()
			end
		end
	end
end)

-- =============================================
-- HUMANOID STATES
-- =============================================
Humanoid.StateChanged:Connect(function(_, newState)
	if newState == Enum.HumanoidStateType.Dead
		or newState == Enum.HumanoidStateType.Climbing
		or newState == Enum.HumanoidStateType.Swimming
		or newState == Enum.HumanoidStateType.Seated then

		if isCrawling then
			isCrawling      = false
			isTransitioning = false
			RootPart:SetAttribute("IsCrawling", false)
			stopCrawlAnims()
			if CrouchToCrawl and CrouchToCrawl.IsPlaying then CrouchToCrawl:Stop(0) end
			if CrawlToCrouch and CrawlToCrouch.IsPlaying then CrawlToCrouch:Stop(0) end
		end
		if isCrouching then
			isCrouching       = false
			isTransitioning   = false
			currentCrouchAnim = nil
			RootPart:SetAttribute("IsCrouching", false)
			stopCrouchAnims()
			Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
			tweenCamOffset(0, 0.25)
			setVignette(1, CONFIG.VignetteFadeOutTime)
			tweenFOV(CONFIG.DefaultFOV, CONFIG.DefaultFOVTime)
		end

		setIKFeetEnabled(true)
		setCrawlLock(false)
	end
end)

-- =============================================
-- RESPAWN
-- =============================================
plr.CharacterAdded:Connect(function(newChar)
	Character = newChar
	Humanoid  = newChar:WaitForChild("Humanoid")
	RootPart  = newChar:WaitForChild("HumanoidRootPart")

	Animator = Humanoid:FindFirstChildOfClass("Animator")
		or Instance.new("Animator", Humanoid)

	CrouchIdle    = safeLoadAnim("Crouching")
	CrouchWalk    = safeLoadAnim("CrouchWalk")
	CrouchToCrawl = safeLoadAnim("CrouchToCrawl")
	CrawlIdle     = safeLoadAnim("CrawlIdle")
	CrawlWalk     = safeLoadAnim("CrawlWalk")
	CrawlToCrouch = safeLoadAnim("CrawlToCrouch")

	configureMovementTrack(CrouchIdle)
	configureMovementTrack(CrouchWalk)
	configureMovementTrack(CrouchToCrawl)
	configureMovementTrack(CrawlIdle)
	configureMovementTrack(CrawlWalk)
	configureMovementTrack(CrawlToCrouch)

	if CrawlIdle then CrawlIdle.Looped = true end
	if CrawlWalk then CrawlWalk.Looped = true end
	if CrouchIdle then CrouchIdle.Looped = true end -- [Meujogo] forca loop
	if CrouchWalk then CrouchWalk.Looped = true end -- [Meujogo] forca loop
	if CrouchToCrawl then CrouchToCrawl.Looped = false end
	if CrawlToCrouch then CrawlToCrouch.Looped = false end

	isCrouching       = false
	isCrawling        = false
	isTransitioning   = false
	isSprinting       = false
	isJogging         = false
	sprintKeyHeld     = false
	crouchDebounce    = true
	crawlDebounce     = true
	currentCrouchAnim = nil
	currentCrawlAnim  = nil
	freefallTimer     = 0
	ikCurrentlyDisabled = false

	RootPart:SetAttribute("IsCrouching",     false)
	RootPart:SetAttribute("IsCrawling",      false)
	RootPart:SetAttribute("CrawlLock",       false)
	RootPart:SetAttribute("IsSprinting",    false)
	RootPart:SetAttribute("IsJogging",       false)
	RootPart:SetAttribute("CanSprint",       true)
	RootPart:SetAttribute("ForceStopSprint", false)

	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)

	if VignetteElement then
		if VignetteElement:IsA("ImageLabel") then
			VignetteElement.ImageTransparency = 1
		else
			VignetteElement.BackgroundTransparency = 1
		end
	end

	Humanoid.StateChanged:Connect(function(_, newState)
		if newState == Enum.HumanoidStateType.Dead then
			if isCrawling then
				isCrawling      = false
				isTransitioning = false
				RootPart:SetAttribute("IsCrawling", false)
				stopCrawlAnims()
			end
			if isCrouching then
				isCrouching     = false
				isTransitioning = false
				RootPart:SetAttribute("IsCrouching", false)
				stopCrouchAnims()
				Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
			end
			setIKFeetEnabled(true)
			setCrawlLock(false)
		end
	end)
end)

-- =============================================
-- INITIAL SETUP
-- =============================================
RootPart:SetAttribute("IsCrouching",     false)
RootPart:SetAttribute("IsCrawling",      false)
RootPart:SetAttribute("CrawlLock",       false)
RootPart:SetAttribute("IsSprinting",    false)
RootPart:SetAttribute("IsJogging",       false)
RootPart:SetAttribute("CanSprint",       true)
RootPart:SetAttribute("ForceStopSprint", false)
Character:SetAttribute("MovementControllerReady", true)</string>
