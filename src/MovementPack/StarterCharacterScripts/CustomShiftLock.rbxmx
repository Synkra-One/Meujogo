          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">SmoothShiftLock</string>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <string name="ScriptGuid">{23DB8249-81EE-428E-B0E7-2A55BADADCCA}</string>
              <string name="Source">

local SmoothShiftLock = {};
SmoothShiftLock.__index = SmoothShiftLock;

--// [ Locals: ]

--// Services
local Workspace = game:GetService("Workspace");
local Players = game:GetService("Players");
local RunService = game:GetService("RunService");
local ContextActionService = game:GetService("ContextActionService");
local UserInputService = game:GetService("UserInputService");

--// Utilities
local Maid = require(script:WaitForChild("Maid"));
local Spring = require(script:WaitForChild("Spring"));

--// Instances
local LocalPlayer = Players.LocalPlayer;
local PlayerMouse = LocalPlayer:GetMouse();
local Camera = Workspace.CurrentCamera;

--// Configuration
local Config = {
	MOBILE_SUPPORT              = false,                      --// Adds a button to toggle the shift lock for touchscreen devices
	SMOOTH_CHARACTER_ROTATION   = true,                       --// If your character should rotate smoothly or not
	CHARACTER_ROTATION_SPEED    = 3,                          --// How quickly character rotates smoothly
	TRANSITION_SPRING_DAMPER    = 0.7,                        --// Camera transition spring damper, test it out to see what works for you
	CAMERA_TRANSITION_IN_SPEED  = 10,                         --// How quickly locked camera moves to offset position
	CAMERA_TRANSITION_OUT_SPEED = 14,                         --// How quickly locked camera moves back from offset position
	LOCKED_CAMERA_OFFSET        = Vector3.new(2.25, 0.35, 0), --// [Meujogo] ombro mais marcado (era 1.75, 0.25, 0)
	CAMERA_COLLISION_PADDING    = 0.12,                       --// Folga entre o volume da camera e paredes
	CAMERA_COLLISION_MARGIN     = 0.10,                       --// Protege tambem as bordas do near plane
	CAMERA_COLLISION_RELEASE    = 12,                         --// Retorno suave do ombro ao sair de uma parede
	LOCKED_MOUSE_ICON           =                             --// Locked mouse icon
		"rbxasset://textures/MouseLockedCursor.png",
	-- [Meujogo] LeftControl agora e o trote (Crouching.WalkKey/JogKeys) --
	-- lista vazia = nenhuma tecla alterna mais a camera de ombro (ela ja
	-- fica ligada por padrao no spawn, ver mais abaixo).
	SHIFT_LOCK_KEYBINDS         =                             --// Shift lock keybinds
		{}
};

--// [ Constructor: ]
function SmoothShiftLock.new()
	local self = setmetatable({}, SmoothShiftLock);

	--// Utilities
	self._runtimeMaid = Maid.new();
	self._shiftlockMaid = Maid.new();
	self._cameraOffsetSpring = Spring.new(Vector3.new(0, 0, 0));
	self._cameraOffsetSpring.Damper = Config.TRANSITION_SPRING_DAMPER;
	self._cameraCollisionFraction = 1;
	self._cameraRaycastParams = RaycastParams.new();
	self._cameraRaycastParams.FilterType = Enum.RaycastFilterType.Exclude;
	self._cameraRaycastParams.IgnoreWater = true;
	self._cameraRaycastParams.RespectCanCollide = true;

	--// Variables
	self.Enabled = false;

	--// Setup
	self:Enable();

	return self;
end;

--// [ Module Functions: ]
function SmoothShiftLock:Enable()
	self:_refreshCharacterVariables();
	self._runtimeMaid:GiveTask(LocalPlayer.CharacterAdded:Connect(function()
		self:_refreshCharacterVariables();

		--// FIX: The engine silently resets UserInputService.MouseBehavior
		--// (and everything visual) on respawn, but self.Enabled stayed true
		--// if it was true when you died. That desync caused the first
		--// Shift press after respawn to silently toggle Enabled to false
		--// (looking like nothing happened), and only the second press
		--// visibly re-enabled it.
		--//
		--// Fix: sempre resetar pra um estado limpo no spawn.
		--// [Meujogo] a camera de ombro e o PADRAO do jogo. Ainda resetamos
		--// o estado (pra reconectar o RenderStepped de rotacao no character
		--// NOVO -- o antigo apontava pro Humanoid/RootPart que morreram), mas
		--// logo depois religamos em vez de nascer com camera solta.
		self._shiftlockMaid:DoCleaning();
		self.Enabled = false;
		self.Humanoid.AutoRotate = true;
		self:_updateMouseState();
		self:_updateMouseIcon();
		self:_transitionLockOffset();
		task.defer(function()
			self:ToggleShiftLock(true);
		end);
	end));

	--// Bind Keybinds
	ContextActionService:BindActionAtPriority("ShiftLockSwitchAction", function(Name, State, Input)
		return self:_doShiftLockSwitch(Name, State, Input);
	end, Config.MOBILE_SUPPORT, Enum.ContextActionPriority.Medium.Value, unpack(Config.SHIFT_LOCK_KEYBINDS));

	--// Camera Offset
	self._runtimeMaid:GiveTask(RunService.RenderStepped:Connect(function(Delta: number)
		Camera = Workspace.CurrentCamera or Camera;
		if not Camera then return; end;
		--// [Meujogo] CameraType ~= Custom quer dizer que outro sistema assumiu
		--// a camera na mao (o menu inicial, por exemplo, via CameraType =
		--// Scriptable) -- nao brigar pelo CFrame dela enquanto isso. Sem isto,
		--// mesmo com CursorLivre travando so o mouse, este offset de ombro
		--// continuava escrevendo em Camera.CFrame TODO frame (a cabeca do
		--// personagem fica a milhares de studs da camera do menu, entao
		--// Distance &gt; 1 e sempre verdadeiro) -- duas fontes escrevendo a
		--// mesma propriedade todo frame e exatamente o tremor.
		if Camera.CameraType ~= Enum.CameraType.Custom then return; end;
		if self.Head.LocalTransparencyModifier &gt; 0.6 then return; end;

		local CameraCFrame = Camera.CoordinateFrame;
		local Distance = (self.Head.Position - CameraCFrame.p).magnitude;

		--// Camera offset
		if Distance &gt; 1 then
			--// O PlayerModule ja resolveu a colisao da camera central neste frame.
			--// O antigo deslocamento de ombro era aplicado depois disso e podia atravessar
			--// uma parede lateral. Varremos o volume real do near plane antes de mover:
			--// a camera entra imediatamente quando bloqueada e volta suavemente ao ombro.
			local BaseCameraCFrame = Camera.CFrame;
			local WantedOffset = self._cameraOffsetSpring.Position;
			local SafeOffset = self:_getCollisionSafeOffset(BaseCameraCFrame, WantedOffset, Delta);
			Camera.CFrame = (BaseCameraCFrame * CFrame.new(SafeOffset));
			local wantLocked = self:_wantsLockedCursor();
			if wantLocked and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
				self:_updateMouseState();
			elseif not wantLocked and self.Enabled and UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
				self:_updateMouseState(); --// [Meujogo] cursor livre pedido: solta
			end;
		end;
	end));
end;

function SmoothShiftLock:Disable()
	self._runtimeMaid:DoCleaning();
	self._shiftlockMaid:DoCleaning();

	--// Unbind Keybinds
	ContextActionService:UnbindAction("ShiftLockSwitchAction");
end;

--// [ Internal Functions: ]
function SmoothShiftLock:_refreshCharacterVariables()
	self.Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait();
	self.RootPart = self.Character:WaitForChild("HumanoidRootPart");
	self.Humanoid = self.Character:WaitForChild("Humanoid");
	self.Head = self.Character:WaitForChild("Head");
	self._cameraRaycastParams.FilterDescendantsInstances = {self.Character};
end;

--// Impede que o offset de ombro seja aplicado atraves de paredes.
--// Um raycast protege o ponto da camera e um blockcast protege todo o retangulo
--// que realmente sera renderizado no near plane (inclusive quinas da tela).
function SmoothShiftLock:_getCollisionSafeOffset(BaseCFrame: CFrame, WantedOffset: Vector3, Delta: number): Vector3
	local WantedDistance = WantedOffset.Magnitude;
	if WantedDistance &lt; 0.001 then
		self._cameraCollisionFraction = 1;
		return WantedOffset;
	end;

	self._cameraRaycastParams.FilterDescendantsInstances = {self.Character};
	local WorldDirection = BaseCFrame:VectorToWorldSpace(WantedOffset);
	local SafeDistance = WantedDistance;

	local function considerHit(Result: RaycastResult?)
		if Result then
			SafeDistance = math.min(
				SafeDistance,
				math.max(0, Result.Distance - Config.CAMERA_COLLISION_PADDING)
			);
		end;
	end;

	--// Protege o ponto da camera contra paredes muito finas.
	considerHit(Workspace:Raycast(BaseCFrame.Position, WorldDirection, self._cameraRaycastParams));

	--// Protege o near plane inteiro: somente checar o centro ainda deixaria as
	--// bordas da tela atravessarem paredes ao girar junto de uma quina.
	local Viewport = Camera.ViewportSize;
	if Viewport.Y &gt; 0 then
		local NearDistance = math.max(math.abs(Camera.NearPlaneZ), 0.1);
		local UnpaddedHalfHeight = math.tan(math.rad(Camera.FieldOfView * 0.5)) * NearDistance;
		local HalfHeight = UnpaddedHalfHeight + Config.CAMERA_COLLISION_MARGIN;
		local HalfWidth = UnpaddedHalfHeight * (Viewport.X / Viewport.Y)
			+ Config.CAMERA_COLLISION_MARGIN;
		local NearPlaneCFrame = BaseCFrame * CFrame.new(0, 0, -NearDistance);
		local NearPlaneSize = Vector3.new(
			HalfWidth * 2,
			HalfHeight * 2,
			Config.CAMERA_COLLISION_MARGIN * 2
		);
		considerHit(Workspace:Blockcast(
			NearPlaneCFrame,
			NearPlaneSize,
			WorldDirection,
			self._cameraRaycastParams
		));
	end;

	local SafeFraction = math.clamp(SafeDistance / WantedDistance, 0, 1);
	if SafeFraction &lt; self._cameraCollisionFraction then
		--// Fechar imediatamente: nunca existe um frame visivel do outro lado.
		self._cameraCollisionFraction = SafeFraction;
	else
		--// Abrir suavemente evita o "tranco" ao desencostar da parede.
		local ReleaseAlpha = 1 - math.exp(-Config.CAMERA_COLLISION_RELEASE * math.min(Delta, 0.1));
		self._cameraCollisionFraction += (SafeFraction - self._cameraCollisionFraction) * ReleaseAlpha;
	end;

	return WantedOffset * self._cameraCollisionFraction;
end;

--// Internal function for ContextActionService
function SmoothShiftLock:_doShiftLockSwitch(_, State: Enum.UserInputState)
	if State == Enum.UserInputState.Begin then
		self:ToggleShiftLock();
		return Enum.ContextActionResult.Sink;
	end;

	return Enum.ContextActionResult.Pass;
end;

--// [Meujogo] a mira fica travada no centro SE a camera de ombro esta ligada
--// E ninguem pediu cursor livre. CharacterSelectController seta o Attribute
--// "CursorLivre" no LocalPlayer enquanto a tela de escolha esta aberta.
function SmoothShiftLock:_wantsLockedCursor(): boolean
	return self.Enabled and LocalPlayer:GetAttribute("CursorLivre") ~= true;
end;

--// Update the mouse behaviour
function SmoothShiftLock:_updateMouseState()
	local locked = self:_wantsLockedCursor();
	UserInputService.MouseBehavior = (locked and Enum.MouseBehavior.LockCenter) or Enum.MouseBehavior.Default;
	-- MouseBehavior sozinho pode deixar o ponteiro invisivel depois da tela
	-- de selecao. Mantenha os dois estados sincronizados.
	UserInputService.MouseIconEnabled = not locked;
end;

--// Update the mouse icon
function SmoothShiftLock:_updateMouseIcon()
	PlayerMouse.Icon = (self:_wantsLockedCursor() and Config.LOCKED_MOUSE_ICON :: string) or "";
end;

--// Transition the camera to lock offset
function SmoothShiftLock:_transitionLockOffset()
	if self.Enabled then
		self._cameraOffsetSpring.Speed = Config.CAMERA_TRANSITION_IN_SPEED;
		self._cameraOffsetSpring.Target = Config.LOCKED_CAMERA_OFFSET;
	else
		self._cameraOffsetSpring.Speed = Config.CAMERA_TRANSITION_OUT_SPEED;
		self._cameraOffsetSpring.Target = Vector3.new(0, 0, 0);
	end;
end;

--// [ External Functions: ]
function SmoothShiftLock:IsEnabled(): boolean
	return self.Enabled;
end;

--// ShiftLock toggle function
function SmoothShiftLock:ToggleShiftLock(Enable: boolean?)
	if Enable ~= nil then
		self.Enabled = Enable;
	else
		self.Enabled = not self.Enabled;
	end;

	self:_updateMouseState();
	self:_updateMouseIcon();
	self:_transitionLockOffset();
	if self.Enabled then
		self._shiftlockMaid:GiveTask(RunService.RenderStepped:Connect(function(Delta: number)
			if (self.Humanoid and self.RootPart) then 
				self.Humanoid.AutoRotate = not self.Enabled;
			end;

			--// FIX: Skip rotation entirely while crawling or transitioning
			--// in/out of crawl. The Crouch script sets the "CrawlLock"
			--// attribute on the RootPart for exactly this purpose — rotating
			--// the RootPart's upright collider every frame while the crawl
			--// animation has it pressed low against the floor causes the
			--// physics engine to nudge it sideways to resolve the overlap,
			--// which is what produced the slow drift while shift lock was on.
			if self.RootPart:GetAttribute("CrawlLock") then return; end;

			--// Rotate the character
			if self.Humanoid.Sit then return; end;
			if LocalPlayer:GetAttribute("CursorLivre") == true then return; end; --// [Meujogo]
			if Config.SMOOTH_CHARACTER_ROTATION then
				local x, y, z = Camera.CFrame:ToOrientation();
				self.RootPart.CFrame = self.RootPart.CFrame:Lerp(CFrame.new(self.RootPart.Position) * CFrame.Angles(0, y, 0), Delta * 5 * Config.CHARACTER_ROTATION_SPEED);
			else
				local x, y, z = Camera.CFrame:ToOrientation();
				self.RootPart.CFrame = CFrame.new(self.RootPart.Position) * CFrame.Angles(0, y, 0);
			end;
		end));
	else
		self.Humanoid.AutoRotate = true;
		self._shiftlockMaid:DoCleaning();
	end;
end;

local shiftLock = SmoothShiftLock.new();

--// [Meujogo] aplica a troca de cursor no mesmo instante que "CursorLivre" muda
--// (a tela de escolha de personagem abre/fecha).
LocalPlayer:GetAttributeChangedSignal("CursorLivre"):Connect(function()
	shiftLock:_updateMouseState();
	shiftLock:_updateMouseIcon();
end);

--// [Meujogo] Camera de ombro LIGADA por padrao (era so no LeftControl).
--// LeftControl continua alternando -- desligar solta o mouse do centro,
--// que e como da pra clicar na hotbar / nos prompts.
task.defer(function()
	shiftLock:ToggleShiftLock(true);
end);

return shiftLock;</string>
