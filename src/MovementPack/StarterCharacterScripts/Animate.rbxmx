<?xml version='1.0' encoding='utf-8'?>
<roblox version="4"><Item class="LocalScript" referent="123">
          <Properties>
            <string name="Name">Animate</string>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <bool name="Disabled">false</bool>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <token name="RunContext">0</token>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{2C765EEA-A178-40BE-8BF8-748FEF08EF2D}</string>
            <string name="Source">local Figure = script.Parent
-- [Meujogo] R6 obrigatorio. Sem timeout, WaitForChild trava aqui pra
-- sempre em R15 e NENHUMA animacao roda (nem a default, que fica suprimida
-- pelo nome "Animate"). Com timeout + aviso, da pra ver o motivo no Output.
local Torso = Figure:WaitForChild("Torso", 8)
if not Torso then
	warn("[Animate] SEM 'Torso' apos 8s -&gt; o jogo NAO esta em R6. "
		.. "Game Settings &gt; Avatar &gt; Avatar Type &gt; R6. Animacoes de movimento desligadas.")
	return
end
local Humanoid = Figure:WaitForChild("Humanoid")
local HumanoidRootPart = Figure:WaitForChild("HumanoidRootPart")
local FOOT_OFFSET = Vector3.new(0, -2.9, 0)

local sprintImpactTemplate = script:FindFirstChild("SprintImpact")
local sprintEmitter
local sprintEmitters = {} -- [Meujogo] TODOS os emissores, nao so o primeiro

if sprintImpactTemplate then
	local impactAttachment = sprintImpactTemplate:Clone()
	-- [Meujogo] ATRAS do pe: em R6 o LookVector da HumanoidRootPart e -Z,
	-- entao +Z fica pras costas do personagem.
	impactAttachment.Position = FOOT_OFFSET + Vector3.new(0, 0, 1.2)
	impactAttachment.Orientation = Vector3.new(-90, 0, 0)
	impactAttachment.Parent = HumanoidRootPart

	-- [Meujogo] o original fazia FindFirstChildWhichIsA("ParticleEmitter2"),
	-- e "ParticleEmitter2" nao e ClassName nenhum (e o NOME do emissor) --
	-- entao 3 dos 4 emissores vinham nil e a fumaca quase nao aparecia.
	for _, child in impactAttachment:GetDescendants() do
		if child:IsA("ParticleEmitter") then
			table.insert(sprintEmitters, child)
		end
	end
	sprintEmitter = sprintEmitters[1]

	if not sprintEmitter then
		warn("[Sprint] No ParticleEmitter found inside SprintImpact.")
	end
else
	warn("[Sprint] No 'SprintImpact' Attachment found under this script.")
end

-- [Meujogo] baforada curta atras do pe ao ENGATAR a corrida.
local function emitSprintDust(amount)
	if Figure:GetAttribute("ShadowRushBusy") == true then return end
	for _, emitter in sprintEmitters do
		emitter:Emit(amount)
	end
end

local sprintDustPlayed = false
local pose = "Standing"

local ContentProvider = game:GetService("ContentProvider")

local shadowAnimationActive = false
local currentAnim = ""
local currentAnimInstance = nil
local currentAnimTrack = nil
local currentAnimKeyframeHandler = nil
local currentAnimSpeed = 1.0
local isAirborne = false

local TRANSITIONS = {
	idle_to_walk = 0.25,
	walk_to_idle = 0.30,
	walk_to_run  = 0.18,
	run_to_walk  = 0.22,
	run_to_idle  = 0.30,
	default      = 0.28,
}

local animTable = {}

-- Um único Animate controla o personagem. O perfil Previous mantém as
-- animações que já estavam funcionando no jogo; ImportedArczis fica guardado
-- para teste sem precisar reimportar outro script no Workspace.
local ANIMATION_PROFILE = "Previous"
local LOCOMOTION_PROFILES = {
	ImportedArczis = {
		idle = "rbxassetid://77181920794051",
		walk = "rbxassetid://125038208630708",
		run = "rbxassetid://96383664079896",
		climb = "rbxassetid://132969691712833",
		fall = "rbxassetid://71277689201143",
		jump = "rbxassetid://123602498784037",
	},
	Previous = {
		idle = "rbxassetid://111750589949462",
		walk = "rbxassetid://104664677962249",
		run = "rbxassetid://84555759625363",
		climb = "rbxassetid://180436334",
		fall = "rbxassetid://110440366272499",
		jump = "rbxassetid://120443640364165",
	},
}
local locomotion = LOCOMOTION_PROFILES[ANIMATION_PROFILE]
assert(locomotion, "Perfil de animação inválido: " .. tostring(ANIMATION_PROFILE))

-- All animation IDs are defined here in the script only.
-- (No longer reads Animation objects parented under this script.)
local animNames = {
	idle = {
		{ id = locomotion.idle, weight = 10 },
	},
	walk = {
		{ id = locomotion.walk, weight = 10 },
	},
	-- [Meujogo] Trotar (Crouching.startJog, segurar ControlKey). Mesmo lugar
	-- que walk/run: e so mais um item de animNames, tocado por onRunning().
	jog = {
		{ id = "rbxassetid://82928206448633", weight = 10 },
	},
	hurt_idle = {
		{ id = "rbxassetid://96462680767143", weight = 10 }, -- [Meujogo] dano parado
	},
	hurt_walk = {
		{ id = "rbxassetid://123093322235597", weight = 10 }, -- [Meujogo] dano andando
	},
	run = {
		{ id = locomotion.run, weight = 10 },
	},
	swim = {
		{ id = "rbxassetid://131167550146543", weight = 10 }, -- [Meujogo] nado ao mover dentro da agua
	},
	climb = {
		{ id = locomotion.climb, weight = 10 },
	},
	sit = {
		{ id = "rbxassetid://178130996", weight = 10 },
	},
	fall = {
		{ id = locomotion.fall, weight = 10 },
	},
	jump = {
		{ id = locomotion.jump, weight = 10 },
	},
	death = {
		{ id = "rbxassetid://136002279138060", weight = 10 }, -- [Meujogo] morte do player
	},
}

-- Builds animTable[name] purely from the fileList defined above.
local function configureAnimationSet(name, fileList)
	animTable[name] = { count = 0, totalWeight = 0 }

	for i, anim in ipairs(fileList) do
		local inst = Instance.new("Animation")
		inst.Name = name
		inst.AnimationId = anim.id
		animTable[name][i] = { anim = inst, weight = anim.weight }
		animTable[name].count += 1
		animTable[name].totalWeight += anim.weight
	end
end

for name, list in pairs(animNames) do
	configureAnimationSet(name, list)
end

pcall(function()
	local assets = {}
	for _, set in pairs(animTable) do
		for i = 1, set.count do
			table.insert(assets, set[i].anim)
		end
	end
	ContentProvider:PreloadAsync(assets)
end)

local function pickAnim(name)
	local set = animTable[name]
	if not set or set.count == 0 then return nil end
	local roll = math.random(1, set.totalWeight)
	local idx = 1
	while roll &gt; set[idx].weight do
		roll -= set[idx].weight
		idx  += 1
	end
	return set[idx].anim
end

local function getTransition(from, to)
	return TRANSITIONS[from .. "_to_" .. to] or TRANSITIONS.default
end

local function stopAllAnimations()
	local old = currentAnim
	currentAnim = ""
	currentAnimInstance = nil
	if currentAnimKeyframeHandler then
		currentAnimKeyframeHandler:Disconnect()
		currentAnimKeyframeHandler = nil
	end
	if currentAnimTrack then
		currentAnimTrack:Stop(TRANSITIONS.default)
		currentAnimTrack:Destroy()
		currentAnimTrack = nil
	end
	return old
end

local function setAnimationSpeed(speed)
	if speed == currentAnimSpeed then return end
	currentAnimSpeed = speed
	if currentAnimTrack then
		currentAnimTrack:AdjustSpeed(speed)
	end
end

local function playAnimation(animName, forcedTransition)
	-- Durante a forma sombria, o rig não deve herdar passada ou corrida.
	local rushState = Figure:GetAttribute("ShadowRushState")
	if rushState == "EnteringShadow" or rushState == "ShadowRush" then return end
	if shadowAnimationActive then return end
	local hrp = Figure:FindFirstChild("HumanoidRootPart")

	-- While a landing-effects script is playing its own animation, don't let
	-- ANYTHING from this script play over it (fall/jump included) — not just
	-- idle/walk. Without this, a physics micro-bounce right after touching
	-- ground can re-trigger onFreeFall/onJumping and restart the fall
	-- animation, bypassing the stop that already happened on landing.
	if hrp and hrp:GetAttribute("IsLanding") then
		return
	end

	-- While crouching, only allow sit and climb (blocks jump too)
	if hrp and hrp:GetAttribute("IsCrouching") then
		if animName ~= "sit" and animName ~= "climb" then
			return
		end
	end

	local anim = pickAnim(animName)
	if not anim then return end
	if anim == currentAnimInstance then return end

	local transition = forcedTransition or getTransition(currentAnim, animName)

	if currentAnimTrack then
		currentAnimTrack:Stop(transition)
		currentAnimTrack:Destroy()
	end
	if currentAnimKeyframeHandler then
		currentAnimKeyframeHandler:Disconnect()
	end

	currentAnimSpeed    = 1.0
	-- [Meujogo] Animator:LoadAnimation (o Humanoid:LoadAnimation do pacote e
	-- deprecado e as vezes nao toca com Animator ja presente).
	local _animator = Humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", Humanoid)
	currentAnimTrack    = _animator:LoadAnimation(anim)
	-- Locomoção abaixo das ações da arma. Core também é inferior a Action;
	-- seu valor numérico 1000 NÃO significa prioridade mais alta.
	currentAnimTrack.Priority = Enum.AnimationPriority.Movement
	-- [Meujogo] forca loop nas continuas: se a anim do usuario foi publicada
	-- como nao-loopavel, sem isso ela toca uma vez e congela.
	if animName == "idle" or animName == "walk" or animName == "jog" or animName == "run" or animName == "swim" then
		currentAnimTrack.Looped = true
	end
	currentAnimTrack:Play(transition)
	-- [Meujogo] avisa no Output se a anim nao carregou (ID invalido / privado / R15 em rig R6)
	do
		local _t, _n, _id = currentAnimTrack, animName, tostring(anim.AnimationId)
		task.delay(2, function()
			if _t and _t.IsPlaying and _t.Length == 0 then
				warn("[Animate] a animacao '" .. _n .. "' (" .. _id .. ") nao carregou -- ID invalido, privado, ou R15 num rig R6")
			end
		end)
	end
	currentAnim         = animName
	currentAnimInstance = anim

	currentAnimKeyframeHandler = currentAnimTrack.KeyframeReached:Connect(
		function(frame)
			if frame == "End" then
				local rName  = currentAnim
				local rSpeed = currentAnimSpeed
				playAnimation(rName)
				setAnimationSpeed(rSpeed)
			end
		end
	)
end

local function horizontalSpeed()
	local hrp = Figure:FindFirstChild("HumanoidRootPart")
	if not hrp then return 0 end
	local v = hrp.Velocity
	return Vector3.new(v.X, 0, v.Z).Magnitude
end

local function isMovingBackwards()
	local hrp = Figure:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	local v = hrp.Velocity
	if v.Magnitude &lt; 0.5 then return false end
	return v.Unit:Dot(hrp.CFrame.LookVector) &lt; -0.2
end

-- Use the movement script's Shift state for sprint animation. WalkSpeed alone
-- can be raised by monster/passive/power multipliers and should still walk.
local SPRINT_SPEED_THRESHOLD = 20
-- [Meujogo] mesma ideia para o trote (Crouching.IsJogging): so entra abaixo
-- disso se a velocidade real caiu por outro motivo (agua, atordoamento),
-- e nao pelo JogSpeed do personagem (12,45 a 21,25 studs/s, sempre acima).
local JOG_SPEED_THRESHOLD = 10

function onRunning(speed)
	local rushState = Figure:GetAttribute("ShadowRushState")
	if rushState == "EnteringShadow" or rushState == "ShadowRush" then return end
	local hrp = Figure:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:GetAttribute("IsCrouching") then return end
	if hrp and hrp:GetAttribute("IsLanding") then return end
	if Humanoid:GetState() == Enum.HumanoidStateType.Swimming then
		onSwimming(speed)
		return
	end
	if isAirborne then return end

	if speed &gt; 0.5 then
		if isMovingBackwards() then
			playAnimation("walk")
			setAnimationSpeed(-speed / 14.5)
		elseif hrp and hrp:GetAttribute("IsSprinting") == true
			and Humanoid.WalkSpeed &gt;= SPRINT_SPEED_THRESHOLD then
			playAnimation("run")
			setAnimationSpeed(1.3)

			-- Play sprint start dust once
			if not sprintDustPlayed then
				sprintDustPlayed = true
				emitSprintDust(8) -- [Meujogo] fumaca pequena, nao explosao
			end
		elseif hrp and hrp:GetAttribute("IsJogging") == true
			and Humanoid.WalkSpeed &gt;= JOG_SPEED_THRESHOLD then
			playAnimation("jog")
			setAnimationSpeed(speed / 14.5)
		else
			playAnimation("walk")
			setAnimationSpeed(speed / 14.5)
		end
		pose = "Running"
	else
		playAnimation("idle")
		pose = "Standing"
	end
	if Humanoid.WalkSpeed &lt; SPRINT_SPEED_THRESHOLD then
		sprintDustPlayed = false
	end
end

function onDied()
	-- DamageSystem toca a morte no servidor para todos verem a mesma pose.
	-- Aqui só congelamos a máquina local de locomoção para ela não sobrescrever.
	pose = "Dead"
end
function onGettingUp()        pose = "GettingUp"          end
function onFallingDown()      pose = "FallingDown"        end
function onSeated()           pose = "Seated"             end
function onPlatformStanding() pose = "PlatformStanding"   end

function onSwimming(speed)
	if speed &gt; 0.5 then
		playAnimation("swim", 0.2)
		setAnimationSpeed(math.max(0.7, speed / 14.5))
		pose = "Swimming"
	else
		playAnimation("idle", 0.25)
		pose = "Standing"
	end
end

function onClimbing(speed)
	playAnimation("climb", 0.1)
	setAnimationSpeed(speed / 12.0)
	pose = "Climbing"
end

function onFreeFall()
	isAirborne = true
	playAnimation("fall", 0.3)
	pose = "FreeFall"
end

function onJumping(active)
	local hrp = Figure:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:GetAttribute("IsCrouching") then return end

	if active then
		isAirborne = true
		playAnimation("jump", 0.1)
		pose = "Jumping"
	end
end

-- Move loop: ONLY handles animation state, zero WalkSpeed changes.
-- [Meujogo] tirei o dt/lastTick: era codigo morto (move so olha `pose`) e
-- estourava porque task.wait() devolve 1 valor, nao 2 como o wait() antigo.
function move()
	if pose == "Seated" then
		playAnimation("sit", 0.5)
	elseif pose == "Dead" then
		return
	elseif pose == "GettingUp"
		or pose == "FallingDown"
		or pose == "PlatformStanding" then
		stopAllAnimations()
	end
end

-- Jumping and Freefall must be enabled together. Leaving Freefall disabled
-- while Jumping is enabled breaks the humanoid's state machine mid-jump,
-- which is what was causing the character to lose its colliders (except
-- the head) after jumping.
Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
Humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)

Humanoid.Died:Connect(onDied)
Humanoid.Running:Connect(onRunning)
Humanoid.Climbing:Connect(onClimbing)
Humanoid.GettingUp:Connect(onGettingUp)
Humanoid.FreeFalling:Connect(onFreeFall)
Humanoid.FallingDown:Connect(onFallingDown)
Humanoid.Seated:Connect(onSeated)
Humanoid.PlatformStanding:Connect(onPlatformStanding)
Humanoid.Swimming:Connect(onSwimming)
Humanoid.Jumping:Connect(onJumping)

Humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
	if Humanoid.WalkSpeed &gt;= SPRINT_SPEED_THRESHOLD then
		if not sprintDustPlayed then
			sprintDustPlayed = true
			emitSprintDust(8) -- [Meujogo] fumaca pequena, nao explosao
		end
	else
		sprintDustPlayed = false
	end
end)

Humanoid.StateChanged:Connect(function(_, newState)
	if newState == Enum.HumanoidStateType.Swimming then
		isAirborne = false
		task.defer(function()
			onSwimming(horizontalSpeed())
		end)
	elseif newState == Enum.HumanoidStateType.Landed
		or newState == Enum.HumanoidStateType.Running
		or newState == Enum.HumanoidStateType.RunningNoPhysics then
		isAirborne = false

		-- Don't wait for the next Running event (it only fires when speed
		-- CHANGES). Force an immediate re-check so standing still after a
		-- jump doesn't leave the fall/jump animation stuck playing.
		-- Deferred so it runs AFTER any other script (e.g. a landing effects
		-- script) has a chance to set the IsLanding attribute this frame.
		task.defer(function()
			local hrp = Figure:FindFirstChild("HumanoidRootPart")
			local horizSpeed = 0
			if hrp then
				local v = hrp.Velocity
				horizSpeed = Vector3.new(v.X, 0, v.Z).Magnitude
			end
			onRunning(horizSpeed)
		end)
	end
end)

-- If a landing-effects script (or anything else) sets IsLanding true to
-- temporarily take over animation, stop our own track immediately so it
-- doesn't blend with the landing animation (both are Core priority, so
-- without this they'd play on top of each other). When IsLanding goes
-- back to false, re-check the animation so idle/walk resumes correctly
-- instead of staying stuck (Running only fires on a speed CHANGE).
HumanoidRootPart:GetAttributeChangedSignal("IsLanding"):Connect(function()
	if HumanoidRootPart:GetAttribute("IsLanding") then
		stopAllAnimations()
		return
	end
	task.defer(function()
		local v = HumanoidRootPart.Velocity
		local horizSpeed = Vector3.new(v.X, 0, v.Z).Magnitude
		onRunning(horizSpeed)
	end)
end)

HumanoidRootPart:GetAttributeChangedSignal("IsCrouching"):Connect(function()
	if HumanoidRootPart:GetAttribute("IsCrouching") then
		stopAllAnimations()
		return
	end
	task.defer(function()
		local v = HumanoidRootPart.Velocity
		local horizSpeed = Vector3.new(v.X, 0, v.Z).Magnitude
		onRunning(horizSpeed)
	end)
end)

-- Shadow Rush uses this existing animation owner and the server-created
-- Animator. Only the owning client starts the track; Roblox replicates it.
local RushConfig = require(game:GetService("ReplicatedStorage").Modules.GameConfig).Monster.ShadowRush
local rushTrack, rushAnimation = nil, nil
local rushLoadAttempted = false
local rushConnections = {}
local function resetRushJointTransforms()
	for _, descendant in Figure:GetDescendants() do
		if descendant:IsA("Motor6D") then
			descendant.Transform = CFrame.new()
		end
	end
end
local function updateRushAnimation()
	local state = Figure:GetAttribute("ShadowRushState")
	-- A animação é exclusivamente da locomoção: a entrada ainda usa a
	-- transição visual de sombra, sem começar um clip de corpo cedo demais.
	local shadowActive = state == "EnteringShadow" or state == "ShadowRush"
	local playLocomotionTrack = state == "ShadowRush"
	if shadowActive and Humanoid.Health &gt; 0 then
		-- Sem AnimationId própria, a forma ainda suspende a locomoção normal;
		-- o VFX apresenta uma silhueta que flutua, sem mudar a física.
		shadowAnimationActive = true
		stopAllAnimations()
		if playLocomotionTrack and RushConfig.ShadowRushAnimationId ~= "" and not rushLoadAttempted then
			local animator = Humanoid:FindFirstChildOfClass("Animator")
			if not animator then return end -- retry when the replicated Animator arrives
			rushAnimation = Instance.new("Animation")
			rushAnimation.Name, rushAnimation.AnimationId = "ShadowRushLocomotion", RushConfig.ShadowRushAnimationId
			local ok, result = pcall(function() return animator:LoadAnimation(rushAnimation) end)
			if ok then
				rushTrack = result
				rushLoadAttempted = true
				rushTrack.Priority, rushTrack.Looped = Enum.AnimationPriority.Action, true
			else
				shadowAnimationActive = false
				rushAnimation:Destroy()
				rushAnimation = nil
				warn("[ShadowRush] Animation unavailable: " .. tostring(result))
			end
		end
		if playLocomotionTrack and rushTrack then
			if not rushTrack.IsPlaying then rushTrack:Play(0.1, 1, 1) end
		end
	else
		shadowAnimationActive = false
		if rushTrack and rushTrack.IsPlaying then
			rushTrack:Stop(if state == "Materializing" then RushConfig.ShadowRushMaterializeDuration else 0.1)
		end
		resetRushJointTransforms()
	end
	if not shadowAnimationActive and Humanoid.Health &gt; 0 then
		onRunning(horizontalSpeed())
	end
end
table.insert(rushConnections, Figure:GetAttributeChangedSignal("ShadowRushState"):Connect(updateRushAnimation))
table.insert(rushConnections, Figure:GetAttributeChangedSignal("ShadowRushBusy"):Connect(updateRushAnimation))
table.insert(rushConnections, Humanoid.ChildAdded:Connect(function(child)
	if child:IsA("Animator") then updateRushAnimation() end
end))
local function destroyRushAnimation()
	shadowAnimationActive = false
	for _, connection in rushConnections do connection:Disconnect() end
	table.clear(rushConnections)
	if rushTrack then rushTrack:Stop(0); rushTrack:Destroy(); rushTrack = nil end
	if rushAnimation then rushAnimation:Destroy(); rushAnimation = nil end
end
table.insert(rushConnections, Humanoid.Died:Connect(destroyRushAnimation))
table.insert(rushConnections, script.Destroying:Connect(destroyRushAnimation))
updateRushAnimation()

playAnimation("idle", 0.3)
pose = "Standing"

while Figure.Parent ~= nil do
	task.wait(0.1)
	move()
end</string>
